# Backend database. Leave DATABASE_URL unset (or point at sqlite) for local dev without Docker.
# Local dev default: sqlite:///./pricewise.db
# Docker/prod-like: postgresql+psycopg2://pricewise:pricewise@postgres:5432/pricewise
DATABASE_URL=sqlite:///./pricewise.db

# LLM provider abstraction. "mock" requires no external calls (see app/intelligence).
LLM_PROVIDER=mock
LLM_API_KEY=

# Optional external market data API (unused in Phase 1; system works without it).
MARKET_DATA_API_KEY=

# Frontend -> backend base URL.
NEXT_PUBLIC_API_URL=http://localhost:8000
